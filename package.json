{
  "name": "zeroseams",
  "version": "0.1.0",
  "description": "Desktop app for creating seamless Instagram carousels",
  "main": "out/main/index.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "postinstall": "node node_modules/electron/install.js",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "npm run build && npm run test:undo && npm run test:frames && npm run test:media",
    "test:undo": "node scripts/test-undo-redo.mjs",
    "test:frames": "node scripts/test-frame-render-export.mjs",
    "test:media": "node scripts/test-media-insertion.mjs",
    "test:video": "node scripts/test-video.mjs",
    "test:axis": "node scripts/test-axis-lock.mjs",
    "test:multiselect": "node scripts/test-multiselect-transform.mjs",
    "test:save-path": "node scripts/test-save-path.mjs"
  },
  "build": {
    "appId": "com.zeroseams.app",
    "productName": "Zero Seams",
    "fileAssociations": [
      {
        "ext": "zeroseams",
        "name": "Zero Seams Project",
        "role": "Editor"
      }
    ]
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@imgly/background-removal": "^1.4.5",
    "chokidar": "^3.6.0",
    "konva": "^9.3.15",
    "lucide-react": "^1.16.0",
    "onnxruntime-web": "^1.18.0",
    "react": "^18.3.1",
    "react-colorful": "^5.7.0",
    "react-dom": "^18.3.1",
    "react-konva": "^18.2.10",
    "use-image": "^1.1.0",
    "utif": "^3.1.0",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@types/chokidar": "^1.7.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/utif": "^3.0.6",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^42.2.0",
    "electron-vite": "^5.0.0",
    "playwright": "^1.60.0",
    "typescript": "^5.5.3",
    "vite": "^7.0.0"
  }
}
